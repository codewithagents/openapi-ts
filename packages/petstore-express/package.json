{
  "name": "petstore-express",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node node_modules/openapi-zod-ts/dist/cli.cjs && node node_modules/@codewithagents/openapi-server/dist/cli.cjs",
    "start": "pnpm generate && tsx src/server/index.ts",
    "test": "pnpm generate && vitest run",
    "typecheck": "pnpm generate && tsc --noEmit -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "express": "^5.0.0",
    "zod": "catalog:",
    "openapi-zod-ts": "workspace:*",
    "@codewithagents/openapi-server": "workspace:*"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "catalog:",
    "@types/supertest": "^7.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.0.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
