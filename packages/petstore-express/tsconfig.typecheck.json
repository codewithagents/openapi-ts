// Scoped typecheck for the openapi-server generated output.
// DOM is added to lib so the fetch client (client.ts, client-config.ts) compiles under
// strict tsc: it uses fetch, URLSearchParams, FormData, AbortSignal, Blob, etc.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"]
  },
  "include": [
    "src",
    "generated/service.ts",
    "generated/router.ts",
    "generated/models.ts",
    "generated/client.ts",
    "generated/client-config.ts",
    "generated/index.ts"
  ]
}
