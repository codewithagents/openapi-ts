  "components": {
    "schemas": {
      "MxString": {
        "type": "string",
        "description": "CONSTRUCT: plain string"
      },
      "MxEmail": {
        "type": "string",
        "format": "email",
        "description": "CONSTRUCT: string+format email"
      },
      "MxUuid": {
        "type": "string",
        "format": "uuid",
        "description": "CONSTRUCT: string+format uuid"
      },
      "MxDateTime": {
        "type": "string",
        "format": "date-time",
        "description": "CONSTRUCT: string+format date-time"
      },
      "MxDate": {
        "type": "string",
        "format": "date",
        "description": "CONSTRUCT: string+format date"
      },
      "MxUri": {
        "type": "string",
        "format": "uri",
        "description": "CONSTRUCT: string+format uri"
      },
      "MxInteger": {
        "type": "integer",
        "description": "CONSTRUCT: integer"
      },
      "MxInt32": {
        "type": "integer",
        "format": "int32",
        "description": "CONSTRUCT: integer+format int32"
      },
      "MxInt64": {
        "type": "integer",
        "format": "int64",
        "description": "CONSTRUCT: integer+format int64"
      },
      "MxFloat": {
        "type": "number",
        "format": "float",
        "description": "CONSTRUCT: number+format float"
      },
      "MxDouble": {
        "type": "number",
        "format": "double",
        "description": "CONSTRUCT: number+format double"
      },
      "MxBoolean": {
        "type": "boolean",
        "description": "CONSTRUCT: boolean"
      },
      "MxStringEnum": {
        "type": "string",
        "enum": ["alpha", "beta", "gamma"],
        "description": "CONSTRUCT: string enum"
      },
      "MxIntegerEnum": {
        "type": "integer",
        "enum": [1, 2, 3],
        "description": "CONSTRUCT: integer enum"
      },
      "MxStringConst": {
        "type": "string",
        "const": "fixed-value",
        "description": "CONSTRUCT: string const"
      },
      "MxNumberConst": {
        "type": "number",
        "const": 42,
        "description": "CONSTRUCT: number const"
      },
      "MxArrayOfPrimitive": {
        "type": "array",
        "items": { "type": "string" },
        "description": "CONSTRUCT: array of primitive"
      },
      "MxArrayOfRef": {
        "type": "array",
        "items": { "$ref": "#/components/schemas/MxObject" },
        "description": "CONSTRUCT: array of $ref"
      },
      "MxArrayOfArray": {
        "type": "array",
        "items": {
          "type": "array",
          "items": { "type": "integer" }
        },
        "description": "CONSTRUCT: array of array of primitive (nested)"
      },
      "MxTuple": {
        "type": "object",
        "required": ["pair"],
        "properties": {
          "pair": {
            "type": "array",
            "prefixItems": [{ "type": "string" }, { "type": "integer" }, { "type": "boolean" }],
            "description": "CONSTRUCT: tuple via prefixItems"
          }
        },
        "description": "CONSTRUCT: tuple via prefixItems in object property"
      },
      "MxTupleWithRest": {
        "type": "object",
        "required": ["tagged"],
        "properties": {
          "tagged": {
            "type": "array",
            "prefixItems": [{ "type": "string" }, { "type": "number" }],
            "items": { "type": "string" },
            "description": "CONSTRUCT: tuple with rest (items after prefixItems)"
          }
        },
        "description": "CONSTRUCT: tuple+rest in object property"
      },
      "MxObject": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string" },
          "count": { "type": "integer" }
        },
        "description": "CONSTRUCT: object with properties and required"
      },
      "MxRecord": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        },
        "description": "CONSTRUCT: record (additionalProperties: schema)"
      },
      "MxObjectWithBoth": {
        "type": "object",
        "required": ["label"],
        "properties": {
          "label": { "type": "string" },
          "count": { "type": "integer" }
        },
        "additionalProperties": {
          "type": "number"
        },
        "description": "CONSTRUCT: object with both properties and additionalProperties"
      },
      "MxNullableStringUnion": {
        "type": ["string", "null"],
        "description": "CONSTRUCT: nullable string (3.1 type-union form)"
      },
      "MxNullableArrayUnion": {
        "oneOf": [{ "type": "array", "items": { "type": "string" } }, { "type": "null" }],
        "description": "CONSTRUCT: nullable array with items (3.1 type-union form)"
      },
      "MxNullableObjectUnion": {
        "oneOf": [{ "$ref": "#/components/schemas/MxObject" }, { "type": "null" }],
        "description": "CONSTRUCT: nullable object with properties (3.1 type-union form)"
      },
      "MxNullableRecordUnion": {
        "oneOf": [{ "$ref": "#/components/schemas/MxRecord" }, { "type": "null" }],
        "description": "CONSTRUCT: nullable record (3.1 type-union form)"
      },
      "MxNullableRefUnion": {
        "oneOf": [{ "$ref": "#/components/schemas/MxObject" }, { "type": "null" }],
        "description": "CONSTRUCT: nullable $ref (3.1 type-union form)"
      },
      "MxNullableStringLegacy": {
        "type": "string",
        "nullable": true,
        "description": "CONSTRUCT: nullable string (3.0 nullable:true form)"
      },
      "MxNullableArrayLegacy": {
        "type": "array",
        "items": { "type": "string" },
        "nullable": true,
        "description": "CONSTRUCT: nullable array with items (3.0 nullable:true form)"
      },
      "MxNullableObjectLegacy": {
        "type": "object",
        "nullable": true,
        "required": ["val"],
        "properties": {
          "val": { "type": "string" }
        },
        "description": "CONSTRUCT: nullable object with properties (3.0 nullable:true form)"
      },
      "MxNullableRecordLegacy": {
        "type": "object",
        "nullable": true,
        "additionalProperties": {
          "type": "integer"
        },
        "description": "CONSTRUCT: nullable record (3.0 nullable:true form)"
      },
      "MxNullableRefLegacy": {
        "allOf": [{ "$ref": "#/components/schemas/MxObject" }],
        "nullable": true,
        "description": "CONSTRUCT: nullable $ref (3.0 nullable:true form)"
      },
      "MxBase1": {
        "type": "object",
        "required": ["field1"],
        "properties": {
          "field1": { "type": "string" }
        },
        "description": "Base type for allOf/anyOf composition"
      },
      "MxBase2": {
        "type": "object",
        "required": ["field2"],
        "properties": {
          "field2": { "type": "integer" }
        },
        "description": "Second base type for composition"
      },
      "MxAllOfRefs": {
        "allOf": [
          { "$ref": "#/components/schemas/MxBase1" },
          { "$ref": "#/components/schemas/MxBase2" }
        ],
        "description": "CONSTRUCT: allOf of 2 $refs"
      },
      "MxAllOfWithSiblingProps": {
        "allOf": [
          { "$ref": "#/components/schemas/MxBase1" },
          {
            "type": "object",
            "required": ["extra"],
            "properties": {
              "extra": { "type": "boolean" }
            }
          }
        ],
        "description": "CONSTRUCT: allOf with sibling properties"
      },
      "MxAnyOfRefs": {
        "anyOf": [
          { "$ref": "#/components/schemas/MxBase1" },
          { "$ref": "#/components/schemas/MxBase2" }
        ],
        "description": "CONSTRUCT: anyOf of 2 $refs"
      },
      "MxAnyOfWithNull": {
        "anyOf": [{ "$ref": "#/components/schemas/MxBase1" }, { "type": "null" }],
        "description": "CONSTRUCT: anyOf including a null type"
      },
      "MxDiscBase": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "kind": { "type": "string" }
        },
        "description": "Discriminator base for oneOf"
      },
      "MxVariantA": {
        "allOf": [
          { "$ref": "#/components/schemas/MxDiscBase" },
          {
            "type": "object",
            "required": ["aValue"],
            "properties": {
              "aValue": { "type": "string" }
            }
          }
        ],
        "description": "oneOf variant A"
      },
      "MxVariantB": {
        "allOf": [
          { "$ref": "#/components/schemas/MxDiscBase" },
          {
            "type": "object",
            "required": ["bCount"],
            "properties": {
              "bCount": { "type": "integer" }
            }
          }
        ],
        "description": "oneOf variant B"
      },
      "MxOneOfRefs": {
        "oneOf": [
          { "$ref": "#/components/schemas/MxBase1" },
          { "$ref": "#/components/schemas/MxBase2" }
        ],
        "description": "CONSTRUCT: oneOf of 2 $refs"
      },
      "MxOneOfDiscriminator": {
        "oneOf": [
          { "$ref": "#/components/schemas/MxVariantA" },
          { "$ref": "#/components/schemas/MxVariantB" }
        ],
        "discriminator": {
          "propertyName": "kind",
          "mapping": {
            "typeA": "#/components/schemas/MxVariantA",
            "typeB": "#/components/schemas/MxVariantB"
          }
        },
        "description": "CONSTRUCT: oneOf + discriminator with mapping"
      },
      "MxTreeNode": {
        "type": "object",
        "required": ["value"],
        "properties": {
          "value": { "type": "string" },
          "left": { "$ref": "#/components/schemas/MxTreeNode" },
          "right": { "$ref": "#/components/schemas/MxTreeNode" }
        },
        "description": "CONSTRUCT: self-recursive schema (tree node)"
      },
      "MxMutualA": {
        "type": "object",
        "required": ["aName"],
        "properties": {
          "aName": { "type": "string" },
          "child": { "$ref": "#/components/schemas/MxMutualB" }
        },
        "description": "CONSTRUCT: mutual cycle A (A has B)"
      },
      "MxMutualB": {
        "type": "object",
        "required": ["bName"],
        "properties": {
          "bName": { "type": "string" },
          "parent": { "$ref": "#/components/schemas/MxMutualA" }
        },
        "description": "CONSTRUCT: mutual cycle B (B has A)"
      },
      "MxCycleCompA": {
        "allOf": [
          { "$ref": "#/components/schemas/MxBase1" },
          {
            "type": "object",
            "properties": {
              "next": { "$ref": "#/components/schemas/MxCycleCompB" }
            }
          }
        ],
        "description": "CONSTRUCT: cycle through composition A (allOf includes ref to B)"
      },
      "MxCycleCompB": {
        "anyOf": [
          { "$ref": "#/components/schemas/MxCycleCompA" },
          { "$ref": "#/components/schemas/MxBase2" }
        ],
        "description": "CONSTRUCT: cycle through composition B (anyOf refs A)"
      },
      "MxMultiTypeStringInt": {
        "type": ["string", "integer"],
        "description": "CONSTRUCT: multi-type union string|integer"
      },
      "MxMultiTypeStringIntNull": {
        "type": ["string", "integer", "null"],
        "description": "CONSTRUCT: multi-type union string|integer|null"
