{
  "openapi": "3.1.0",
  "info": {
    "title": "Matrix Coverage Spec",
    "version": "1.0.0",
    "description": "Fictional spec exercising every concretely-representable construct in every position. Used by the no-partial-unknown coverage net in @codewithagents/integration."
  },
  "paths": {
    "/matrix/primitives": {
      "get": {
        "operationId": "getPrimitiveEcho",
        "summary": "Echo primitives via query params",
        "parameters": [
          { "name": "strParam", "in": "query", "schema": { "type": "string" } },
          {
            "name": "emailParam",
            "in": "query",
            "schema": { "type": "string", "format": "email" }
          },
          { "name": "uuidParam", "in": "query", "schema": { "type": "string", "format": "uuid" } },
          { "name": "dateParam", "in": "query", "schema": { "type": "string", "format": "date" } },
          { "name": "intParam", "in": "query", "schema": { "type": "integer" } },
          {
            "name": "int32Param",
            "in": "query",
            "schema": { "type": "integer", "format": "int32" }
          },
          { "name": "numParam", "in": "query", "schema": { "type": "number" } },
          { "name": "boolParam", "in": "query", "schema": { "type": "boolean" } }
        ],
        "responses": {
          "200": {
            "description": "All-primitive container as response body (response-body position)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MxAllPrimitivesContainer" }
              }
            }
          }
        }
      }
    },
    "/matrix/primitives/{id}/{code}": {
      "get": {
        "operationId": "getPrimitiveByPath",
        "summary": "Path params: string and integer",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int32" }
          }
        ],
        "responses": {
          "200": {
            "description": "Formats container as response body",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MxFormatsContainer" }
              }
            }
          }
        }
      }
    },
