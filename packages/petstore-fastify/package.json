{
  "name": "petstore-fastify",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "node node_modules/openapi-zod-ts/dist/cli.cjs && node node_modules/openapi-zod-ts/dist/cli.cjs --config openapi-zod-ts.auth.config.json && node node_modules/@codewithagents/openapi-server/dist/cli.cjs && node node_modules/@codewithagents/openapi-server/dist/cli.cjs --config openapi-server.auth.config.json",
    "start": "pnpm generate && tsx src/server/index.ts",
    "test": "pnpm generate && vitest run",
    "test:e2e": "pnpm generate && playwright test",
    "typecheck": "pnpm generate && tsc --noEmit -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@codewithagents/openapi-server": "workspace:*",
    "@fastify/formbody": "^8.0.0",
    "@fastify/multipart": "^9.0.0",
    "fastify": "^5.0.0",
    "fastify-type-provider-zod": "^6.1.0",
    "openapi-zod-ts": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "catalog:",
    "tsx": "^4.0.0",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
