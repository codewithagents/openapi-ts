{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "ignorePatterns": [
    "examples/generated/**",
    "examples/generated-rq/**",
    "packages/*/dist/**",
    "packages/*/generated/**",
    "packages/*/generated-matrix/**",
    "packages/*/generated-matrix-legit/**",
    "packages/openapi-zod-ts/src/__fixtures__/**",
    "packages/petstore-hono/**"
  ],
  "ignoreUnresolvedImports": [
    "**/generated/**",
    "**/generated-matrix/**",
    "**/generated-matrix-legit/**"
  ],
  "ignoreDependencies": [
    "zod",
    "@faker-js/faker",
    "fastify-type-provider-zod",
    "@fastify/formbody",
    "@fastify/multipart",
    "@codewithagents/petstore-hono",
    "hono",
    "express",
    "@types/express"
  ],
  "rules": {
    "unused-files": "warn",
    "unused-exports": "warn",
    "unused-types": "off"
  },
  "health": {
    "maxCyclomatic": 15,
    "maxCognitive": 12
  }
}
