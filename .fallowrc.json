{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "ignorePatterns": [
    "examples/generated/**",
    "examples/generated-rq/**",
    "packages/*/dist/**",
    "packages/*/generated/**",
    "packages/openapi-zod-ts/src/__fixtures__/**",
    "packages/petstore-hono/**"
  ],
  "ignoreUnresolvedImports": ["**/generated/**"],
  "ignoreDependencies": ["zod", "@faker-js/faker", "fastify-type-provider-zod"],
  "rules": {
    "unused-files": "warn",
    "unused-exports": "warn",
    "unused-types": "off"
  },
  "health": {
    "maxCyclomatic": 15,
    "maxCognitive": 12
  }
}
